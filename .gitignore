.DS_Store
.idea/
.vscode/
*.log
*.retry
*.swp
*.swo
*~

# Terraform working data
.terraform/
terraform/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
terraform/*.tfplan
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Provider mirrors and caches
.cache/
terraform-provider-mirror/
terraform-plugin-cache/

# Local build and bundle outputs
dist/
build/

# Runtime artefacts
.tmp/
terraform/.generated/
terraform/*.auto.tfvars.json
