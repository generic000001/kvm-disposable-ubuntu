# VM images and manifests generated at runtime
images/*.img
images/*.qcow2
images/*.iso
images/*.sha256
images/*.SHA256SUMS
images/*.SHA256SUMS.gpg
images/*.metadata.json
images/*.partial
images/*.part

# Generated keys and secrets
*.pem
*.key
*.pub.tmp
id_*
!images/.gitkeep
